# HireD Driver App — Environment Configuration
# Note: Mobile apps bundle .env, never put server secrets, passwords or private keys here.

# Base REST API endpoint for the HireD Backend (Node.js / Express / Prisma on port 5000)
API_BASE_URL=http://10.0.2.2:5000/api/v1

# Maps & Navigation Configuration:
# - In-app maps use OpenStreetMap raster tiles via flutter_map + latlong2.
# - Tile attribution: "© OpenStreetMap contributors"
# - Turn-by-turn navigation opens external Google Maps via plain URL helper (maps_config.dart).
# - NO Google Maps SDK, NO Google API keys, NO Google cloud billing, NO Google Directions/Places/Geocoding APIs.
