# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL 17)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hired_dev?schema=public"

# Authentication & Security
JWT_ACCESS_SECRET="your-256-bit-access-secret-here"
JWT_REFRESH_SECRET="your-256-bit-refresh-secret-here"
FILE_SIGNING_SECRET="your-256-bit-file-signing-secret-here"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
# Test Database Configuration (Used by npm test)
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/hired_test?schema=public"

# Real Driver Account Seeding
SEED_DRIVER1_PASSWORD=
SEED_DRIVER2_PASSWORD=

# Driver 2 Live Location Seeding
SEED_DRIVER2_PICKUP=
SEED_DRIVER2_LAT=
SEED_DRIVER2_LNG=

# Email SMTP Configuration (Gmail App Password)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
