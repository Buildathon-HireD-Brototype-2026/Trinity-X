# ==============================================================================
# Backend Environment Configuration
# ==============================================================================
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# You can connect to PostgreSQL using EITHER Option A OR Option B:
#
# Option A: Single Connection String (DATABASE_URL)
# Recommended for cloud providers (Supabase, Neon, AWS RDS, Railway, Render, etc.)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:1234@localhost:5432/hired_dev?schema=public"

# Option B: Separate Connection Variables
# Useful when credentials and hosts are managed individually (e.g. Docker, Kubernetes, CI/CD)
# If DATABASE_URL is not provided or empty, these variables will be used automatically:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=hired_dev
# DB_USER=postgres
# DB_PASSWORD=your_postgres_password
# DB_SSL=false

# Connection Pool Settings
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=5000

# Direct Realtime Listener URL (Optional)
# If your primary DATABASE_URL points to a connection pooler like PgBouncer in transaction mode,
# PostgreSQL LISTEN/NOTIFY requires a direct connection to PostgreSQL rather than through a transaction pooler.
# Set DB_LISTEN_URL to connect the realtime listener directly to the PostgreSQL instance:
# DB_LISTEN_URL="postgresql://postgres:1234@localhost:5432/hired_dev?schema=public"

# Test Database Configuration (Used during automated test runs)
DATABASE_URL_TEST="postgresql://postgres:1234@localhost:5432/hired_test?schema=public"

# ------------------------------------------------------------------------------
# Authentication & Security Keys (JWT & Secrets)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET="your-256-bit-access-secret-here-change-in-production"
JWT_REFRESH_SECRET="your-256-bit-refresh-secret-here-change-in-production"
FILE_SIGNING_SECRET="your-256-bit-file-signing-secret-here-change-in-production"
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7

# ------------------------------------------------------------------------------
# CORS Allowed Origins
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5000,http://localhost:8080

# ------------------------------------------------------------------------------
# External Services & Geocoding
# ------------------------------------------------------------------------------
NOMINATIM_USER_AGENT=HireD-Platform-Buildathon/1.0 (contact: support@hired.local)
OSRM_SERVER_URL=https://router.project-osrm.org

